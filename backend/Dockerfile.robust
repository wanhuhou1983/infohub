# InfoHub Backend — 自愈版本（使用 node:22-alpine + bun via npm）
# 构建方式：
#   docker build -t infohub-backend -f backend/Dockerfile.robust backend/
#
# 不依赖 oven/bun 镜像，使用本地已缓存的 node:22-alpine

FROM node:22-alpine AS build

WORKDIR /app

# 安装 bun（通过 npm）
RUN npm install -g bun --silent 2>/dev/null

# 复制依赖文件
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile --production 2>/dev/null || bun install --production

# ============ Stage 2: 运行阶段 ============
FROM node:22-alpine AS run

WORKDIR /app

# 安装运行时工具
RUN apk add --no-cache curl ca-certificates tzdata

# 从构建阶段复制 bun 和 node_modules
COPY --from=build /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/bun/bin/bun /usr/local/bin/bun

COPY --from=build /app/node_modules ./node_modules
COPY . .

# 创建数据目录
RUN mkdir -p /app/data

EXPOSE 3001

# 健康检查
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3001/api/test || exit 1

CMD ["bun", "run", "index.ts"]
