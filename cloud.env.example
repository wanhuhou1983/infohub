# InfoHub 本地/云端脱钩后的环境变量样例
# 全部为占位符，切勿把真实凭据写入本文件并提交。
#
# 实际部署形态（2026-11-14 核实）：
#   云端：GHCR 镜像 infohub-backend，容器 env 只有 PORT / CLOUD_MODE / DATABASE_URL 等基础项，
#         其余键从挂载的 /opt/infohub/.env.json（ro）读取。
#   本地：backend/.env 与 backend/.env.json。
#   两地唯一互动：本地 → 云端 PG 同步（SSH 隧道 15432 → 云端 5433）。

# ===== 通用 =====
DATABASE_URL=postgres://user:pass@host:5432/infohub
ADMIN_TOKEN=replace_with_admin_token
TZ=Asia/Shanghai
PYTHON_PATH=/usr/bin/python3

# ===== 云端：文本类采集 + 展示，文本数据权威源 =====
CLOUD_MODE=true
COLLECTOR_MODE=true
# 云端采集器内部回环调用令牌，随机长字符串；只用于本机 127.0.0.1 调用
INTERNAL_FETCH_TOKEN=replace_with_random_internal_token
# 云端不写 Obsidian Markdown，但仍做图片下载 + COS 上传 + 正文 URL 替换
OB_WRITE_ENABLED=false
COS_ARCHIVE_ENABLED=true
# RSS 默认关闭：/api/fetch/rss 串着翻译/图片/播客转录等本地能力，云端跑会超时。
# RSS 文本由本地采集后经 PG 同步上云。需要云端接管时设为 true。
CLOUD_RSS_ENABLED=false
# 今天看啥 API（公众号 / 微博 / 雪球动态）
JTK_USER=replace_with_jtk_user
JTK_TOKEN=replace_with_jtk_token
# 微信正文四层降级的第一层，需在云端同网络起 wechat-service 容器
WECHAT_SERVICE_URL=http://wechat-service:8978
# COS：图片 + 原文 JSON 归档
COS_SECRET_ID=replace_with_cos_secret_id
COS_SECRET_KEY=replace_with_cos_secret_key
COS_BUCKET=wanhuhou-1300445858
COS_REGION=ap-shanghai

# ===== 本地 Mac：音视频采集与整理 =====
# CLOUD_MODE=false
# COLLECTOR_MODE=false
# 灰度期保持 true（本地继续采文本用于比对）；切换完成后设为 false，
# 本地即只跑播客 / B站 / YouTube / 推特与播客频道 RSS。
# LOCAL_TEXT_FETCH=false
# PG 同步通道
# CLOUD_DB_URL=postgres://user:pass@localhost:15432/infohub
# 默认白名单（含 RSS，云端不采 RSS）：云端自采的文本类型绝不可列入
# SYNC_ARTICLE_TYPES=bilibili,podcast-channel,youtube-updates,twitter-updates,magazine,rss,rss-feed,rss_news

# ===== 已废弃 / 不再需要 =====
# MAC_TAILSCALE_IP   云端不再回源 Mac 取图片，图片统一走 COS
# SYNC_TOKEN         仅 HTTP /api/cloud-sync/push 使用，采集模式下不注册该端点
# PG_PASSWORD        历史遗留，代码中无任何引用
